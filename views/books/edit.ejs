<div class="page-form">

  <div class="breadcrumb">
    <a href="/books">Catalogue</a>
    <span class="bc-sep">›</span>
    <a href="/books/<%= book._id %>"><%= book.title %></a>
    <span class="bc-sep">›</span>
    <span>Edit</span>
  </div>

  <div class="form-header">
    <h1 class="page-title">Edit Book</h1>
    <p class="page-subtitle">Update the details for <em><%= book.title %></em></p>
  </div>

  <form method="POST" action="/books/<%= book._id %>?_method=PUT" class="book-form">

    <div class="form-section">
      <h2 class="form-section-title">Book Information</h2>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="title">Title <span class="req">*</span></label>
          <input type="text" id="title" name="title" value="<%= book.title %>" required />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="author">Author <span class="req">*</span></label>
          <input type="text" id="author" name="author" value="<%= book.author %>" required />
        </div>
      </div>

      <div class="form-row form-row--cols">
        <div class="form-group">
          <label for="isbn">ISBN <span class="req">*</span></label>
          <input type="text" id="isbn" name="isbn" value="<%= book.isbn %>" required />
        </div>
        <div class="form-group">
          <label for="genre">Genre <span class="req">*</span></label>
          <select id="genre" name="genre" required>
            <% genres.forEach(g => { %>
              <option value="<%= g %>" <%= book.genre === g ? 'selected' : '' %>><%= g %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4"><%= book.description || '' %></textarea>
        </div>
      </div>
    </div>

    <div class="form-rule"></div>

    <div class="form-section">
      <h2 class="form-section-title">Publication Details</h2>

      <div class="form-row form-row--cols">
        <div class="form-group">
          <label for="publisher">Publisher</label>
          <input type="text" id="publisher" name="publisher" value="<%= book.publisher || '' %>" />
        </div>
        <div class="form-group">
          <label for="publishedYear">Year Published</label>
          <input type="number" id="publishedYear" name="publishedYear" value="<%= book.publishedYear || '' %>" min="1000" max="<%= new Date().getFullYear() %>" />
        </div>
        <div class="form-group">
          <label for="pages">Pages</label>
          <input type="number" id="pages" name="pages" value="<%= book.pages || '' %>" min="1" />
        </div>
      </div>

      <div class="form-row form-row--cols">
        <div class="form-group">
          <label for="language">Language</label>
          <input type="text" id="language" name="language" value="<%= book.language %>" />
        </div>
        <div class="form-group">
          <label for="copies">Number of Copies</label>
          <input type="number" id="copies" name="copies" value="<%= book.copies %>" min="1" required />
          <span class="field-hint">Currently <%= book.availableCopies %> available</span>
        </div>
        <div class="form-group">
          <label for="location">Shelf Location</label>
          <input type="text" id="location" name="location" value="<%= book.location %>" />
        </div>
      </div>

      <div class="form-row form-row--cols">
        <div class="form-group">
          <label for="coverColor">Spine Colour</label>
          <div class="color-picker-row">
            <input type="color" id="coverColor" name="coverColor" value="<%= book.coverColor %>" class="color-picker" />
            <span class="color-hint">Used for visual identification</span>
          </div>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <a href="/books/<%= book._id %>" class="btn-secondary">Cancel</a>
      <button type="submit" class="btn-primary">Save Changes</button>
    </div>

  </form>
</div>
