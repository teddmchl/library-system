<div class="page-form">

  <div class="breadcrumb">
    <a href="/members">Members</a>
    <span class="bc-sep">›</span>
    <span>New Member</span>
  </div>

  <div class="form-header">
    <h1 class="page-title">Register New Member</h1>
    <p class="page-subtitle">A member number will be assigned automatically</p>
  </div>

  <form method="POST" action="/members" class="book-form">

    <div class="form-section">
      <h2 class="form-section-title">Personal Details</h2>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="name">Full Name <span class="req">*</span></label>
          <input type="text" id="name" name="name" value="<%= member.name || '' %>" required placeholder="First and last name" />
        </div>
      </div>

      <div class="form-row form-row--cols">
        <div class="form-group">
          <label for="email">Email Address <span class="req">*</span></label>
          <input type="email" id="email" name="email" value="<%= member.email || '' %>" required placeholder="member@example.com" />
        </div>
        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" value="<%= member.phone || '' %>" placeholder="+44 7700 000000" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= member.address || '' %>" placeholder="Street, Town, Postcode" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" rows="3" placeholder="Any special notes about this member…"><%= member.notes || '' %></textarea>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <a href="/members" class="btn-secondary">Cancel</a>
      <button type="submit" class="btn-primary">Register Member</button>
    </div>

  </form>
</div>
