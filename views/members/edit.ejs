<div class="page-form">

  <div class="breadcrumb">
    <a href="/members">Members</a>
    <span class="bc-sep">›</span>
    <a href="/members/<%= member._id %>"><%= member.name %></a>
    <span class="bc-sep">›</span>
    <span>Edit</span>
  </div>

  <div class="form-header">
    <h1 class="page-title">Edit Member</h1>
    <p class="page-subtitle">Member <%= member.memberNumber %></p>
  </div>

  <form method="POST" action="/members/<%= member._id %>?_method=PUT" class="book-form">

    <div class="form-section">
      <h2 class="form-section-title">Personal Details</h2>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="name">Full Name <span class="req">*</span></label>
          <input type="text" id="name" name="name" value="<%= member.name %>" required />
        </div>
      </div>

      <div class="form-row form-row--cols">
        <div class="form-group">
          <label for="email">Email Address <span class="req">*</span></label>
          <input type="email" id="email" name="email" value="<%= member.email %>" required />
        </div>
        <div class="form-group">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" value="<%= member.phone || '' %>" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="address">Address</label>
          <input type="text" id="address" name="address" value="<%= member.address || '' %>" />
        </div>
      </div>

      <div class="form-row form-row--cols">
        <div class="form-group">
          <label for="status">Account Status</label>
          <select id="status" name="status">
            <option value="active"    <%= member.status === 'active'    ? 'selected' : '' %>>Active</option>
            <option value="suspended" <%= member.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
            <option value="expired"   <%= member.status === 'expired'   ? 'selected' : '' %>>Expired</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group form-group--wide">
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" rows="3"><%= member.notes || '' %></textarea>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <a href="/members/<%= member._id %>" class="btn-secondary">Cancel</a>
      <button type="submit" class="btn-primary">Save Changes</button>
    </div>

  </form>
</div>
