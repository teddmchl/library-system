<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Ashbrook Library</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Crimson+Pro:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- HEADER -->
  <header class="site-header">
    <div class="header-inner">
      <div class="header-brand">
        <a href="/" class="brand-link">
          <span class="brand-ornament">✦</span>
          <div>
            <div class="brand-name">Ashbrook</div>
            <div class="brand-sub">Public Library</div>
          </div>
        </a>
      </div>

      <nav class="site-nav">
        <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Dashboard</a>
        <a href="/books" class="nav-link <%= currentPath.startsWith('/books') ? 'active' : '' %>">Catalogue</a>
        <a href="/members" class="nav-link <%= currentPath.startsWith('/members') ? 'active' : '' %>">Members</a>
        <a href="/loans" class="nav-link <%= currentPath.startsWith('/loans') ? 'active' : '' %>">Loans</a>
      </nav>

      <div class="header-actions">
        <a href="/loans/new" class="btn-checkout">Check Out</a>
      </div>
    </div>
    <div class="header-rule">
      <span></span><span class="rule-diamond">◆</span><span></span>
    </div>
  </header>

  <!-- FLASH MESSAGES -->
  <% if (success && success.length) { %>
    <div class="flash flash-success">
      <span class="flash-icon">✓</span>
      <%= success[0] %>
    </div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="flash flash-error">
      <span class="flash-icon">✕</span>
      <%= error[0] %>
    </div>
  <% } %>

  <!-- MAIN CONTENT -->
  <main class="site-main">
    <%- body %>
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-rule">
        <span></span><span class="rule-diamond">◆</span><span></span>
      </div>
      <div class="footer-content">
        <span class="footer-brand">Ashbrook Public Library</span>
        <span class="footer-sep">·</span>
        <span class="footer-copy">Est. 1891</span>
        <span class="footer-sep">·</span>
        <span class="footer-copy">Library Management System v1.0</span>
      </div>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
